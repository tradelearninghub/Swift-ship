# =============================================================================
# Swift Ship Courier - Environment Configuration
# =============================================================================

# Server Environment
NODE_ENV="production"
PORT=3000
HOSTNAME="0.0.0.0"

# Hostinger Local MySQL Database
# Format: mysql://<DB_USER>:<DB_PASSWORD>@localhost:3306/<DB_NAME>?connection_limit=5
# Note: In Hostinger hPanel, your DB User & DB Name usually have a prefix like "u123456789_"
DATABASE_URL="mysql://u123456789_swiftuser:YourStrongPassword@localhost:3306/u123456789_swiftship?connection_limit=5"

# Application URLs
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
APP_URL="https://yourdomain.com"

# Application Security
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-a-random-32-character-or-longer-secret-key-here"
JWT_SECRET="generate-a-random-32-character-or-longer-secret-key-here"

# 32-byte hex-encoded encryption key for courier API credentials
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Redis & Queue (BullMQ - Optional, falls back to direct execution if not configured)
# REDIS_URL="redis://localhost:6379"

# Notification Channels (Fallbacks & System Defaults)
# SMTP / Email
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="support@yourdomain.com"
SMTP_PASS="your-email-password"
SMTP_FROM_EMAIL="support@yourdomain.com"
SMTP_FROM_NAME="Swift Ship Courier"

# WhatsApp Provider Configuration (Optional)
WHATSAPP_API_URL="https://graph.facebook.com/v19.0"
WHATSAPP_API_KEY="whatsapp_access_token"
WHATSAPP_PHONE_NUMBER_ID="phone_number_id"

# SMS Gateway Configuration (Optional)
SMS_API_URL="https://api.sms-provider.com/v1"
SMS_API_KEY="sms_api_key"
SMS_SENDER_ID="SWFTSH"
