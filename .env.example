# =============================================================================
# SS Courier service - Environment Configuration Template
# Copy this file to .env and fill in your actual production/development credentials.
# NEVER commit .env to version control!
# =============================================================================

# Server Environment
NODE_ENV="production"
PORT=3000
HOSTNAME="0.0.0.0"

# Hostinger Local MySQL Database
# Format: mysql://<DB_USER>:<DB_PASSWORD>@localhost:3306/<DB_NAME>?connection_limit=5
# Note: In Hostinger hPanel, your DB User & DB Name usually have a prefix like "u123456789_"
DATABASE_URL="mysql://u123456789_dbuser:YourSecurePasswordHere@localhost:3306/u123456789_dbname?connection_limit=5"

# Application URLs
NEXT_PUBLIC_APP_URL="https://sscourierservice.in"
APP_URL="https://sscourierservice.in"

# Application Security
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-a-random-32-character-or-longer-secret-key-here"
JWT_SECRET="generate-a-random-32-character-or-longer-secret-key-here"

# 32-byte hex-encoded encryption key for courier API credentials
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Redis & Queue (BullMQ - Optional, falls back to direct execution if not configured)
REDIS_URL="redis://127.0.0.1:6379"

# Notification Channels (Fallbacks & System Defaults)
# SMTP / Email (Hostinger Titan / Standard Webmail)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="noreply@sscourierservice.in"
SMTP_PASS="your-email-password-here"
SMTP_FROM_EMAIL="noreply@sscourierservice.in"
SMTP_FROM_NAME="SS Courier service"

# WhatsApp Provider Configuration (Optional)
WHATSAPP_API_URL="https://graph.facebook.com/v19.0"
WHATSAPP_API_KEY="whatsapp_access_token_here"
WHATSAPP_PHONE_NUMBER_ID="phone_number_id_here"

# SMS Gateway Configuration (Optional)
SMS_API_URL="https://api.sms-provider.com/v1"
SMS_API_KEY="sms_api_key_here"
SMS_SENDER_ID="SSCOUR"

